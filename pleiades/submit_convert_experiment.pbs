#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# Convert ALL datasets of ONE experiment to NetCDF — one PBS job per experiment.
#
# Usage (via submit_convert_parallel.sh):
#   qsub -v EXP_NAME=control submit_convert_experiment.pbs
#   qsub -v EXP_NAME=exp1,NCONC=4 submit_convert_experiment.pbs   # lower if OOM
#   qsub -v EXP_NAME=exp1,DATASET=pft_lim3 submit_convert_experiment.pbs   # subset
#
# NOTE: NCONC defaults to 8. Values >=12 have been observed to OOM/hang the node
# at K_MAX=38 -- raise it only after fixing _materialize() (see NCONC comment below).
#
# Every (dataset, 5-year chunk) pair is an independent task — disjoint iterations,
# disjoint output files — so they all run concurrently on the one node PBS gives us.
# ═══════════════════════════════════════════════════════════════════════════════
#PBS -N oif_conv
#PBS -l select=1:ncpus=40:mem=180gb:model=sky_ele
# Work per experiment (measured 2026-07-09, ~4.4 core-s/month for pft_lim, which is
# 81% of the total): control ~6300 core-s, exp1/exp5 ~3650 core-s each. At NCONC=24
# the makespan was set by the longest single chunk (61 months of pft_lim = ~271 s),
# because HDF5 serialises compression within a chunk: ~4.5 min + ~30 s startup.
# At NCONC=8 (see below) the 91 tasks run in ~12 waves instead of ~4, so budget
# ~12 * 271 s ~= 55 min plus per-task startup; K_MAX=38 also adds ~27% over the
# K_MAX=30 numbers above. 04:00:00 keeps ~2x margin on that.
#PBS -l walltime=04:00:00
#PBS -q normal
#PBS -j oe
#PBS -W group_list=s1353

# ── Paths ─────────────────────────────────────────────────────────────────────
BASE_DIR="/home5/ksuselj1/nobackup/OIF/ED_experiments/OIF-analysis/pleiades"
SCRIPT="${BASE_DIR}/convert_to_netcdf.py"
K_MAX=38  # Changed from 30 to 38: covers 0-2174m, extending past 2000m depth

# Concurrency. Lowered 24 -> 8 (2026-08-17): with K_MAX=38 the job OOM'd/hung the
# node at 24 and still failed at 12; 8 runs cleanly. Observed failure between 8 and
# 12 implies a real per-task peak of ~15-22 GB against the 180 GB request, well above
# the 5.2 GB measured at K_MAX=30 -- the extra 8 levels alone don't explain it.
# Root cause is most likely _materialize(max_inmem_gb=32.0) in convert_to_netcdf.py:
# it decides per task, with no knowledge of NCONC, so N tasks can each load a whole
# chunk and claim up to N * 32 GB. Fixing that (lower the threshold to force the
# streaming path) would let NCONC go back up; until then keep it at 8.
NCONC="${NCONC:-8}"

# Each task is single-threaded and CPU-bound in zlib; stop numpy/BLAS from spawning
# a thread per core in every one of them.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# Longest-processing-time-first: launch the pft_lim datasets before the cheap ones
# so a 271 s chunk never starts last and stretches the makespan.
# OIF efficiency datasets (split into 3 files for manageability):
#   - efficiency_npp_co2: NPP, CO2_flux, pCO2 (for eta_upt, eta_as)
#   - efficiency_export: POC, POSi, PIC, POFe (for eta_exp, ballast)
#   - efficiency_dic_nutrients: DIC, nutrients (for eta_dur, budget)
ALL_DATASETS=(pft_lim1 pft_lim2 pft_lim3 pft_lim4 pft_lim5
              nutrients carbon_tracers co2
              efficiency_npp_co2 efficiency_export efficiency_dic_nutrients
              pft_biomass fe_budget)

YEAR_RANGES=(
    "1992:1996"
    "1997:2001"
    "2002:2006"
    "2007:2011"
    "2012:2016"
    "2017:2021"
    "2022:2026"
)
# ─────────────────────────────────────────────────────────────────────────────

if [[ -z "${EXP_NAME}" ]]; then
    echo "ERROR: EXP_NAME not set"
    exit 1
fi

# Sea ice and physical fields only for control experiment (physical doesn't change with Fe).
if [[ -n "${DATASET}" ]]; then
    DATASETS=("${DATASET}")
else
    DATASETS=("${ALL_DATASETS[@]}")
    if [[ "${EXP_NAME}" == "control" ]]; then
        DATASETS+=("sea_ice")
        DATASETS+=("physical")
    fi
fi

LOG_DIR="/home5/ksuselj1/nobackup/OIF/logs"
CHUNK_LOG_DIR="${LOG_DIR}/chunks"
STATUS_DIR=$(mktemp -d "${TMPDIR:-/tmp}/oif_status.XXXXXX")
mkdir -p "${LOG_DIR}" "${CHUNK_LOG_DIR}"
trap 'rm -rf "${STATUS_DIR}"' EXIT

LOG_FILE="${LOG_DIR}/convert_${EXP_NAME}.log"
exec > "${LOG_FILE}" 2>&1

source ~/python_env/ecco_darwin/bin/activate

DATA_DIR="/home5/ksuselj1/nobackup/OIF/ED_experiments/${EXP_NAME}/run/diags/monthly"

echo "═══════════════════════════════════════════════════════════════════════════════"
echo "Job        : ${PBS_JOBID}"
echo "Node       : $(hostname)"
echo "Start      : $(date)"
echo "Experiment : ${EXP_NAME}"
echo "Datasets   : ${#DATASETS[@]} (${DATASETS[*]})"
echo "Year chunks: ${#YEAR_RANGES[@]} (5-year chunks from 1992-2026)"
echo "Tasks      : $(( ${#DATASETS[@]} * ${#YEAR_RANGES[@]} )) (dataset x chunk)"
echo "Concurrency: ${NCONC} on $(nproc --all) cores"
echo "═══════════════════════════════════════════════════════════════════════════════"
echo ""

# Launch every (dataset, chunk) task, throttled to NCONC at a time.
# Each task writes its own exit code to a status file: `wait -n` in the throttle
# reaps children, so the parent cannot reliably `wait` on individual PIDs later.
NTASKS=0
for DS in "${DATASETS[@]}"; do
    for YEAR_RANGE in "${YEAR_RANGES[@]}"; do
        while (( $(jobs -rp | wc -l) >= NCONC )); do wait -n; done

        START_YEAR="${YEAR_RANGE%%:*}"
        END_YEAR="${YEAR_RANGE##*:}"
        TAG="${DS}_${START_YEAR}-${END_YEAR}"
        CHUNK_LOG="${CHUNK_LOG_DIR}/convert_${EXP_NAME}_${TAG}.log"

        (
            python "${SCRIPT}" "${DATA_DIR}" --k_max "${K_MAX}" --datasets "${DS}" \
                --start-year "${START_YEAR}" --end-year "${END_YEAR}" --skip-existing \
                > "${CHUNK_LOG}" 2>&1
            echo "$?" > "${STATUS_DIR}/${TAG}.status"
        ) &
        NTASKS=$((NTASKS + 1))
    done
done

echo "Launched ${NTASKS} tasks; waiting..."
wait
echo ""

SUCCESS_COUNT=0
FAIL_COUNT=0
for DS in "${DATASETS[@]}"; do
    for YEAR_RANGE in "${YEAR_RANGES[@]}"; do
        START_YEAR="${YEAR_RANGE%%:*}"; END_YEAR="${YEAR_RANGE##*:}"
        TAG="${DS}_${START_YEAR}-${END_YEAR}"
        RC=$(cat "${STATUS_DIR}/${TAG}.status" 2>/dev/null || echo 99)
        if [[ "${RC}" -eq 0 ]]; then
            ((SUCCESS_COUNT++))
        else
            ((FAIL_COUNT++)); echo "✗ Failed (rc=${RC}): ${TAG}"
        fi
    done
done

# Fold the per-chunk logs into this one so the record stays in a single place.
echo ""
for DS in "${DATASETS[@]}"; do
    for YEAR_RANGE in "${YEAR_RANGES[@]}"; do
        START_YEAR="${YEAR_RANGE%%:*}"; END_YEAR="${YEAR_RANGE##*:}"
        echo "───────────────────────────────────────────────────────────────────────────────"
        echo "${DS}  ${START_YEAR}-${END_YEAR}"
        echo "───────────────────────────────────────────────────────────────────────────────"
        cat "${CHUNK_LOG_DIR}/convert_${EXP_NAME}_${DS}_${START_YEAR}-${END_YEAR}.log" 2>/dev/null
        echo ""
    done
done

echo "═══════════════════════════════════════════════════════════════════════════════"
echo "SUMMARY for ${EXP_NAME}"
echo "═══════════════════════════════════════════════════════════════════════════════"
echo "Total tasks    : ${NTASKS}"
echo "Successful     : ${SUCCESS_COUNT}"
echo "Failed         : ${FAIL_COUNT}"
echo "End            : $(date)"
echo "═══════════════════════════════════════════════════════════════════════════════"

[[ ${FAIL_COUNT} -gt 0 ]] && exit 1
exit 0
